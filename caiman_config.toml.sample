# The command caiman runs to discover the layouts installed on your
# system. Needs to print the same YAML that `xkbcli list` does.
list_layout = "xkbcli list"

# Name of a theme installed in ~/.config/rama/themes/, or one of the
# themes bundled with caiman (e.g. "catppuccin-mocha", "dracula",
# "tokyo-night").
theme = "catppuccin-mocha"
